{
  "name": "helm-core",
  "private": true,
  "license": "MIT",
  "description": "Root build orchestrator for the docs site (docs/) and the browser layout tool (helm-toolbox/). Each stays independently runnable; see docs/README.md and helm-toolbox/README.md.",
  "scripts": {
    "setup": "bun run setup:helm-toolbox && bun run setup:docs",
    "setup:docs": "cd docs && bun install",
    "setup:helm-toolbox": "cd helm-toolbox && bun install",

    "build": "bun run docs:build",
    "content:check": "node scripts/check-content.mjs",

    "helm-toolbox:data": "cd helm-toolbox && bun run data",
    "helm-toolbox:vendor": "cd helm-toolbox && bun run vendor",
    "helm-toolbox:wasm": "cd helm-toolbox && bun run wasm",
    "helm-toolbox:test": "cd helm-toolbox && bun run test",
    "helm-toolbox:build": "cd helm-toolbox && bun run build",
    "helm-toolbox:serve": "cd helm-toolbox && bun run serve",
    "helm-toolbox:dev": "cd helm-toolbox && bun run dev",

    "docs:dev": "cd docs && bun run dev",
    "docs:serve": "cd docs && bun run serve",
    "docs:build": "cd docs && bun run build",
    "docs:css:build": "cd docs && bun run css:build",
    "docs:css:watch": "cd docs && bun run css:watch",
    "docs:frames:check": "cd docs && bun run frames:check",
    "docs:icons": "cd docs && bun run icons",
    "docs:icons:refresh": "cd docs && bun run icons:refresh",
    "docs:frames": "cd docs && bun run frames",
    "docs:examples": "cd docs && bun run examples"
  }
}
