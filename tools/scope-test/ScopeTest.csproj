<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the real Program.cs against fake blocks on a fake grid with a docked ship. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <StartupObject>ScopeTest</StartupObject>
    <NoWarn>CS0169;CS0414;CS0649;CS0219;CS8981</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../HelmCore.cs" />
    <Compile Include="../../Program.cs" />
    <Compile Include="../spritedump/SeShim.cs" />
    <Compile Include="../spritedump/SeShim.Blocks.cs" />
    <Compile Include="../spritedump/Dump.cs" />
    <Compile Include="ScopeTest.cs" />
  </ItemGroup>
</Project>
