<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the shipped script the way the Programmable Block does: as the body of
       "partial class Program : MyGridProgram" with the game's usings, at C# 6, and with the
       APIs the game prohibits banned (BannedSymbols.txt). Wrapped.g.cs is written by Build-Release.ps1
       from HelmCombined.min.cs. A build error means the file pasted into the game would not compile.
       Run: pwsh ./Build-Release.ps1 -NoTest; dotnet build tools/spritedump/CombinedCheck -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>6</LangVersion>
    <NoWarn>CS0169;CS0414;CS0649;CS0219;CS8981;CS0168</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <WarningsAsErrors>RS0030</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Wrapped.g.cs" />
    <Compile Include="Main.cs" />
    <ProjectReference Include="../SeShim/SeShim.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>
</Project>
