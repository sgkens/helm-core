<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0169;CS0414;CS0649;CS0219;CS8981</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);HELM_TOOLS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../HelmCore.cs" />
    <Compile Include="../../Program.cs" />
    <Compile Include="SeShim.cs" />
    <Compile Include="SeShim.Blocks.cs" />
    <Compile Include="Dump.cs" />
  </ItemGroup>
</Project>
