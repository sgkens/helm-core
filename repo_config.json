{
  "profile": "swsi",
  "project": {
    "name": "helm-core",
    "displayName": "Helm Core",
    "namespace": "sgkens",
    "path": "sgkens/helm-core",
    "artifactPath": "sgkens/helm-core",
    "defaultBranch": "develop",
    "documentationUrl": "https://sgkens.gitlab.io/helm-core"
  },
  "readme": {
    "requiredHeadings": [
      {
        "level": 2,
        "name": "Features"
      },
      {
        "level": 2,
        "name": "Installation"
      },
      {
        "level": 2,
        "name": "Quick Start"
      },
      {
        "level": 2,
        "name": "Configuration"
      },
      {
        "level": 2,
        "name": "Development"
      },
      {
        "level": 2,
        "name": "License"
      }
    ]
  },
  "commit": {
    "defaultType": "feat",
    "defaultScope": "workshop",
    "defaultDescription": "update Workshop item",
    "types": [
      {
        "name": "feat",
        "description": "add or change user-facing behavior"
      },
      {
        "name": "fix",
        "description": "correct defective behavior"
      },
      {
        "name": "docs",
        "description": "change documentation only"
      },
      {
        "name": "refactor",
        "description": "restructure without behavior changes"
      },
      {
        "name": "perf",
        "description": "improve runtime performance"
      },
      {
        "name": "test",
        "description": "add or correct tests"
      },
      {
        "name": "build",
        "description": "change build or dependencies"
      },
      {
        "name": "ci",
        "description": "change continuous integration"
      },
      {
        "name": "chore",
        "description": "perform repository maintenance"
      },
      {
        "name": "revert",
        "description": "revert an earlier commit"
      }
    ],
    "scopes": [
      {
        "name": "rivet",
        "description": "repository metadata automation",
        "paths": [
          "rivet.ps1",
          ".rivet/**"
        ]
      },
      {
        "name": "workshop",
        "description": "Workshop content and listing",
        "paths": [
          "workshop/**",
          "WORKSHOP.md"
        ]
      },
      {
        "name": "core",
        "description": "item source and build scripts",
        "paths": [
          "src/**",
          "scripts/**",
          "*.cs",
          "*.ps1"
        ]
      },
      {
        "name": "docs",
        "description": "documentation",
        "paths": [
          "docs/**",
          "README*.md"
        ]
      },
      {
        "name": "release",
        "description": "versioning and release assets",
        "paths": [
          "VERSION",
          "CHANGELOG.md",
          "release-notes.md"
        ]
      },
      {
        "name": "ci",
        "description": "pipeline configuration",
        "paths": [
          ".gitlab-ci.yml"
        ]
      },
      {
        "name": "none",
        "description": "omit the commit scope",
        "paths": [
          "**"
        ]
      }
    ],
    "preview": {
      "maxDiffLines": 240
    }
  },
  "authors": {
    "mappings": []
  },
  "tagging": {
    "prefix": "v",
    "releaseSuffix": "-release",
    "remote": "origin"
  },
  "gitlab": {
    "baseUri": "https://gitlab.com",
    "projectId": "",
    "tokenEnvironmentVariable": "GITLAB_API_KEY"
  },
  "metadataSource": "repo_meta.json",
  "labelScope": "project",
  "defaultTextColor": "#FFFFFF",
  "requestTimeoutSeconds": 30,
  "swsi": {
    "manifest": "VERSION"
  }
}
